[Unit]
Description=Credentials Vault (LAN web service)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/credentials
Environment="VAULT_HOST=0.0.0.0"
Environment="VAULT_PORT=8787"
Environment="VAULT_DATA_DIR=/home/admin/credentials"
ExecStart=/home/admin/projects/credentials-vault/venv/bin/python /home/admin/projects/credentials-vault/app.py
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/admin/credentials/logs/vault.log
StandardError=append:/home/admin/credentials/logs/vault.log

[Install]
WantedBy=multi-user.target
