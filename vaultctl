#!/usr/bin/env python3
"""vaultctl — CLI for the credentials-vault (http://127.0.0.1:8787).

Usage:
  vaultctl status
  vaultctl list
  vaultctl get <name>
  vaultctl set <name> <value>
  vaultctl delete <name>
  vaultctl unlock
  vaultctl lock

Master password is read from $VAULT_PASSWORD or ~/.vault-password (mode 0600).
Session state is cached in ~/.vault-cookie / ~/.vault-csrf so repeated calls
are fast; sessions expire after 30 minutes of inactivity.
"""
import http.cookiejar, json, os, subprocess, sys, urllib.request, urllib.error

BASE = os.environ.get("VAULT_URL", "http://127.0.0.1:8787")
PW_FILE = os.path.expanduser("~/.vault-password")
COOKIE_FILE = os.path.expanduser("~/.vault-cookie")
CSRF_FILE = os.path.expanduser("~/.vault-csrf")


def password():
    pw = os.environ.get("VAULT_PASSWORD")
    if pw:
        return pw
    if os.path.exists(PW_FILE):
        with open(PW_FILE) as f:
            return f.read().strip()
    sys.stderr.write("No password: set VAULT_PASSWORD or create " + PW_FILE + "\n")
    sys.exit(2)


def cj():
    jar = http.cookiejar.MozillaCookieJar(COOKIE_FILE)
    if os.path.exists(COOKIE_FILE):
        try:
            jar.load(ignore_discard=True, ignore_expires=True)
        except Exception:
            pass
    return jar


def csrf():
    if os.path.exists(CSRF_FILE):
        with open(CSRF_FILE) as f:
            return f.read().strip()
    return ""


def save_state(jar, token):
    try:
        jar.save(ignore_discard=True, ignore_expires=True)
    except Exception:
        pass
    with open(CSRF_FILE, "w") as f:
        f.write(token)
    try:
        os.chmod(CSRF_FILE, 0o600)
    except OSError:
        pass


def req(method, path, data=None, headers=None):
    h = {"Content-Type": "application/json"} if data is not None else {}
    if headers:
        h.update(headers)
    r = urllib.request.Request(BASE + path, data=(json.dumps(data).encode() if data is not None else None),
                               headers=h, method=method)
    jar = cj()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
    try:
        with opener.open(r) as resp:
            body = resp.read()
            return resp.status, (json.loads(body) if body else {})
    except urllib.error.HTTPError as e:
        body = e.read()
        try:
            j = json.loads(body)
        except Exception:
            j = {"error": body.decode(errors="replace")}
        return e.code, j


def is_locked():
    code, j = req("GET", "/api/status")
    return code != 200 or not j.get("unlocked", False)


def do_unlock():
    code, j = req("POST", "/api/unlock", {"password": password()})
    if code != 200 or not j.get("ok"):
        sys.stderr.write("unlock failed: " + json.dumps(j) + "\n")
        sys.exit(1)
    # cookie jar already saved by req? req uses a fresh jar each call; need to persist.
    # Re-do with cookie saving:
    jar = http.cookiejar.MozillaCookieJar(COOKIE_FILE)
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
    r = urllib.request.Request(BASE + "/api/unlock", data=json.dumps({"password": password()}).encode(),
                               headers={"Content-Type": "application/json"}, method="POST")
    with opener.open(r) as resp:
        body = json.loads(resp.read())
    jar.save(ignore_discard=True, ignore_expires=True)
    with open(CSRF_FILE, "w") as f:
        f.write(body["csrf"])
    os.chmod(COOKIE_FILE, 0o600)
    os.chmod(CSRF_FILE, 0o600)
    return body["csrf"]


def ensure_unlocked():
    if is_locked():
        do_unlock()


def main(argv):
    if len(argv) < 2:
        print(__doc__); sys.exit(0)
    cmd = argv[1]

    if cmd == "status":
        code, j = req("GET", "/api/status")
        print(json.dumps(j))
        return

    if cmd == "unlock":
        do_unlock()
        print("unlocked")
        return

    if cmd == "lock":
        c = csrf()
        code, j = req("POST", "/api/lock", {}, headers={"X-CSRF-Token": c})
        # remove cached state
        for p in (COOKIE_FILE, CSRF_FILE):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass
        print(json.dumps(j))
        return

    if cmd == "list":
        ensure_unlocked()
        code, j = req("GET", "/api/entries")
        if code != 200:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        for n in j.get("entries", []):
            print(n)
        return

    if cmd == "get":
        if len(argv) < 3:
            sys.stderr.write("usage: vaultctl get <name>\n"); sys.exit(2)
        ensure_unlocked()
        name = argv[2]
        code, j = req("GET", "/api/entries/" + urllib.request.quote(name, safe=""))
        if code != 200:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        sys.stdout.write(j["value"])
        if not j["value"].endswith("\n"):
            sys.stdout.write("\n")
        return

    if cmd == "set":
        if len(argv) < 4:
            sys.stderr.write("usage: vaultctl set <name> <value>\n"); sys.exit(2)
        ensure_unlocked()
        name = argv[2]
        value = argv[3]
        code, j = req("POST", "/api/entries", {"name": name, "value": value},
                      headers={"X-CSRF-Token": csrf()})
        if code not in (200, 201):
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        print(json.dumps(j))
        return

    if cmd == "delete":
        if len(argv) < 3:
            sys.stderr.write("usage: vaultctl delete <name>\n"); sys.exit(2)
        ensure_unlocked()
        name = argv[2]
        code, j = req("DELETE", "/api/entries/" + urllib.request.quote(name, safe=""),
                      headers={"X-CSRF-Token": csrf()})
        if code != 200:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        print(json.dumps(j))
        return

    if cmd == "change-password":
        if len(argv) < 3:
            sys.stderr.write("usage: vaultctl change-password <new-password>\n"); sys.exit(2)
        ensure_unlocked()
        new_pw = argv[2]
        code, j = req("POST", "/api/change-password",
                      {"current": password(), "new": new_pw, "confirm": new_pw},
                      headers={"X-CSRF-Token": csrf()})
        if code != 200:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        with open(PW_FILE, "w") as f:
            f.write(new_pw + "\n")
        os.chmod(PW_FILE, 0o600)
        print("password changed and " + PW_FILE + " updated")
        return

    if cmd == "exec":
        # vaultctl exec <name> [--env VAR] -- <command> [args...]
        if "--" not in argv:
            sys.stderr.write("usage: vaultctl exec <name> [--env VAR] -- <command> [args...]\n"); sys.exit(2)
        idx = argv.index("--")
        name = argv[2]
        env_var = None
        i = 3
        while i < idx:
            if argv[i] == "--env":
                if i + 1 >= idx:
                    sys.stderr.write("vaultctl exec: --env needs a value\n"); sys.exit(2)
                env_var = argv[i + 1]
                i += 2
                continue
            sys.stderr.write("vaultctl exec: unknown option " + argv[i] + "\n"); sys.exit(2)
        cmd_args = argv[idx + 1:]
        if not cmd_args:
            sys.stderr.write("vaultctl exec: missing command after --\n"); sys.exit(2)
        ensure_unlocked()
        code, j = req("GET", "/api/entries/" + urllib.request.quote(name, safe=""))
        if code != 200 or "value" not in j:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        value = j["value"]
        var = env_var or name
        env = dict(os.environ)
        env[var] = value
        proc = subprocess.run(cmd_args, env=env, capture_output=True)
        def mask(b):
            try:
                text = b.decode("utf-8", errors="replace")
            except Exception:
                return b
            out = text.replace(value, "[REDACTED]")
            if len(value) >= 6:
                for k in range(len(value) - 5):
                    frag = value[k:k + 6]
                    out = out.replace(frag, "[REDACTED]")
            return out.encode("utf-8", errors="replace")
        sys.stdout.buffer.write(mask(proc.stdout))
        sys.stderr.buffer.write(mask(proc.stderr))
        sys.exit(proc.returncode)

    if cmd == "audit":
        ensure_unlocked()
        n = "100"
        if len(argv) >= 3:
            n = argv[2]
        code, j = req("GET", "/api/audit?n=" + urllib.request.quote(n, safe=""))
        if code != 200:
            sys.stderr.write(json.dumps(j) + "\n"); sys.exit(1)
        for e in j.get("entries", []):
            print(json.dumps(e, ensure_ascii=False))
        return

    sys.stderr.write("unknown command: " + cmd + "\n")
    print(__doc__)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
