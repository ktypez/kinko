[Unit]
Description=Kinko frontend (Svelte/Vite)
After=network.target vaultctl.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/projects/kinko/kinko
Environment="PORT=8788"
Environment="VAULT_URL=http://127.0.0.1:8787"
ExecStartPre=/bin/mkdir -p /home/admin/projects/kinko/kinko/data/logs
ExecStart=/usr/bin/python3 /home/admin/projects/kinko/kinko/serve.py
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/admin/projects/kinko/kinko/serve.log
StandardError=append:/home/admin/projects/kinko/kinko/serve.log

[Install]
WantedBy=multi-user.target